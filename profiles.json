      "tweaks": {
        "services": {
          "disable": ["wuauserv", "bits", "DiagTrack", "dmwappushservice", "WerSvc", "Fax", "Spooler", "RemoteRegistry", "MapsBroker", "SharedAccess", "lfsvc", "RetailDemo", "WMPNetworkSvc", "XblAuthManager", "XblGameSave", "XboxNetApiSvc", "XboxGipSvc", "BthServ", "AJRouter", "NetTcpPortSharing", "TabletInputService"],
