@echo off
setlocal EnableDelayedExpansion

net session >nul 2>&1
if %errorlevel% neq 0 (
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)

if not exist "%TEMP%\sc" mkdir "%TEMP%\sc"

:MAIN
cls
echo.
echo   ==========================================
echo         WINDOWS SUPER SMOOTH
echo   ==========================================
echo.
echo   [1] Start AutoPilot
echo   [2] Live Status
echo   [3] View Log
echo   [4] Stop AutoPilot
echo   [0] Exit
echo.
echo   ==========================================
echo.
choice /c 12340 /n /m "  Select: "
set "s=%errorlevel%"
if !s!==1 goto RUN
if !s!==2 goto STATUS
if !s!==3 goto LOG
if !s!==4 goto STOP
if !s!==5 goto EXIT
goto MAIN

:RUN
echo.
echo   Creating AutoPilot engine...
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if %errorlevel% neq 0 (
    echo   ERROR: Failed to create engine.
    pause
    goto MAIN
)
echo   Engine created. Starting AutoPilot...
echo   Press Ctrl+C in the new window to stop.
start "AutoPilot" powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\sc\engine.ps1"
timeout /t 3 >nul
goto MAIN

:STATUS
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
powershell -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\sc\status.ps1"
goto MAIN

:LOG
cls
echo.
echo   ==========================================
echo         ACTIVITY LOG
echo   ==========================================
echo.
set "lf=%USERPROFILE%\Downloads\systemcare.log"
if exist "%lf%" (
    powershell -NoProfile -Command "Get-Content '%lf%' -Tail 20 | ForEach-Object {Write-Host ('  ' + $_)}"
) else (
    echo   No activity yet.
)
echo.
pause
goto MAIN

:STOP
powershell -NoProfile -Command "Get-Process powershell -EA SilentlyContinue | Stop-Process -Force -EA SilentlyContinue"
echo.
echo   AutoPilot stopped.
echo.
timeout /t 2 >nul
goto MAIN

:EXIT
exit /b
